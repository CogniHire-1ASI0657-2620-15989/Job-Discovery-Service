# PostgreSQL database dedicated to Job-Search.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/pathbridge
DATABASE_SCHEMA=job_discovery
# Create this key at https://pe.jooble.org/api/about. Never commit its value.
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://pe.jooble.org/api
# Header injected by the API Gateway after JWT validation.
GATEWAY_USER_ID_HEADER=X-User-Id
INTERNAL_API_KEY=replace-with-one-long-shared-random-secret
